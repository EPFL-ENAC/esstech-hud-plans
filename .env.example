DB_HOST=localhost
DB_NAME=postgres
DB_USER=user
DB_PASSWORD=password

KEYCLOAK_CLIENT_SECRET=password

# Frontend origin allowed by the API CORS and by tusd (compose)
APP_URL=http://localhost:9000

# Root directory for workflow data, absolute or relative to backend directory
# When USE_SCITAS is true, set DATA_DIR to the same value as SCITAS_MOUNT_EXPORT_PATH
DATA_DIR=data

MIN_COLMAP_IMAGES_KEEP=20

USE_RUNAI=false
RUNAI_REGISTRY=
RUNAI_PVC_SCRATCH_NAME=
RUNAI_REMOTE_SCRATCH_PATH=

USE_SCITAS=false
SCITAS_MOUNT_EXPORT_PATH=/mnt/scitas
SCITAS_REMOTE_EXPORT_PATH=/export/enac-it-poh
SCITAS_REMOTE_SCRATCH_PATH=/scratch/enac-it-poh
SCITAS_REMOTE_IMAGES_PATH=/work/enac-it-poh/apptainer-images
SCITAS_HOST=kuma.hpc.epfl.ch
SCITAS_ACCOUNT=enac-it-poh
SCITAS_SSH_USERNAME=enac-it-poh
SCITAS_SSH_KEY_PATH=~/.ssh/id_ed25519

# Multi-line #SBATCH directives (use \n)
SCITAS_SBATCH_ARGS_COLMAP=
SCITAS_SBATCH_ARGS_BRUSH=

# Host directory where the tusd container stores upload chunks and .info files.
# Must be shared between the tusd container and the backend, and stay on a local
# disk (tusd needs hard links; never on the SCITAS mount). On machines where /tmp
# is not shared with the docker daemon, set it to a path under the repo
# (e.g. backend/data/tusd-uploads)
TUSD_UPLOAD_DIR=/tmp/hud-tusd-uploads

# Age threshold for the tus cleanup flow
TUSD_UPLOAD_RETENTION_DAYS=7

# Hook endpoint URL tusd calls for pre-create validation (used by the compose command).
# The path must match the API PATH_PREFIX (/tus/hooks is mounted under it).
TUSD_HOOKS_HTTP_URL=http://host.docker.internal:8000/api/tus/hooks

# Internal address of the tusd server. The API proxies upload requests to it,
# so the browser never reaches tusd. Dev targets the loopback-published compose
# port. In the real deployment tusd is not exposed and this points at the
# compose service (http://tusd:8080)
TUSD_INTERNAL_URL=http://localhost:8080
