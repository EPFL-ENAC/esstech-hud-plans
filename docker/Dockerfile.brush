FROM nvcr.io/nvidia/cuda:13.1.1-runtime-ubuntu24.04

########################################
# Setup
########################################
RUN apt update && \
    apt install -y \
    curl \
    ca-certificates \
    git \
    build-essential \
    cmake \
    libvulkan1 \
    vulkan-tools \
    mesa-vulkan-drivers \
    nvidia-driver-570

COPY backend/scripts/linux/install_brush.sh /tmp/install_brush.sh
RUN bash /tmp/install_brush.sh /external
RUN apt clean && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 docker/brush_unbuffered.sh /external/bin/brush_unbuffered.sh
RUN ln -s /external/bin/brush_unbuffered.sh /usr/local/bin/brush
